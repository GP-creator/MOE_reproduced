{
  "name": "main",
  "seed": 1337,
  "variant": "switch",
  "data": {
    "dataset": "tinystories",
    "vocab_size": 8192,
    "cache_dir": "data_cache",
    "tokenizer_train_stories": 200000,
    "max_train_tokens": 60000000,
    "max_val_tokens": 2000000
  },
  "model": {
    "n_layers": 6,
    "d_model": 384,
    "n_heads": 6,
    "seq_len": 256,
    "d_ff": 1536,
    "moe_every": 1,
    "init": "switch",
    "init_scale": 0.1,
    "norm_eps": 1e-06,
    "rope_base": 10000
  },
  "moe": {
    "dispatch": "batched",
    "renormalize_gates": false,
    "switch": {
      "n_experts": 8,
      "capacity_factor": 2.0,
      "eval_capacity_factor": null,
      "aux_alpha": 0.01,
      "jitter_eps": 0.01
    },
    "gshard": {
      "n_experts": 16,
      "width_divisor": 2,
      "top_k": 2,
      "capacity_factor": 1.25,
      "eval_capacity_factor": null,
      "aux_alpha": 0.01,
      "jitter_eps": 0.0
    },
    "deepseek": {
      "m": 4,
      "n_shared": 1,
      "n_routed": 31,
      "k_routed": 3,
      "aux_alpha": 0.01,
      "device_aux_alpha": 0.0,
      "n_devices": 1,
      "jitter_eps": 0.0
    },
    "dense_x8": {
      "width_mult": 8
    }
  },
  "train": {
    "batch_size": 32,
    "total_steps": 6000,
    "warmup_steps": 200,
    "peak_lr": 0.002,
    "lr_decay_points": [
      0.8,
      0.9
    ],
    "lr_decay_factor": 0.316,
    "betas": [
      0.9,
      0.95
    ],
    "weight_decay": 0.1,
    "grad_clip": 1.0,
    "eval_interval": 150,
    "eval_batches": 20,
    "routing_log_interval": 50,
    "checkpoint_interval": 500,
    "log_interval": 1,
    "compile": false
  },
  "system": {
    "device": "auto",
    "dtype": "auto",
    "cpu_threads": 8,
    "results_dir": "results"
  }
}